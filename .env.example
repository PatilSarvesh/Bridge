# Optional durable API storage. When omitted, Bridge uses the seeded in-memory demo repository.
DATABASE_URL=postgresql://bridge:bridge@127.0.0.1:5432/bridge

# Optional isolated PostgreSQL database used by the conditional persistence integration test.
BRIDGE_TEST_DATABASE_URL=postgresql://bridge:bridge@127.0.0.1:5432/bridge_test

# Local service addresses. Keep loopback defaults unless intentionally exposing the prototype.
BRIDGE_API_HOST=127.0.0.1
BRIDGE_API_PORT=4000
BRIDGE_MCP_HOST=127.0.0.1
BRIDGE_MCP_PORT=4100
BRIDGE_PUBLIC_WEB_URL=http://127.0.0.1:3000
BRIDGE_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BRIDGE_API_URL=http://127.0.0.1:4000

# Optional OIDC mode. When BRIDGE_OIDC_ISSUER is set, all listed OIDC/session values are required.
# Keep secrets in an environment/deployment secret manager; values below are nonfunctional placeholders.
# BRIDGE_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
# BRIDGE_OIDC_AUDIENCE=https://api.bridge.example
# BRIDGE_OIDC_CLIENT_ID=replace-with-client-id
# BRIDGE_OIDC_CLIENT_SECRET=replace-with-client-secret
# Optional pair for interactive CLI login through a separate Native/public OIDC client.
# BRIDGE_OIDC_CLI_CLIENT_ID=replace-with-native-public-client-id
# BRIDGE_OIDC_CLI_REDIRECT_URI=http://127.0.0.1:8765/callback
# BRIDGE_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# BRIDGE_OIDC_ORGANIZATION_CLAIM=org_id
# BRIDGE_OIDC_LOGIN_ORGANIZATION=org_external_id
# BRIDGE_AUTH_INSECURE_COOKIES=true

# Optional one-time OIDC organization/admin bootstrap. Supply every value together, then remove them.
# BRIDGE_BOOTSTRAP_ORGANIZATION_ID=org_acme
# BRIDGE_BOOTSTRAP_OIDC_ORGANIZATION_ID=org_external_id
# BRIDGE_BOOTSTRAP_ORGANIZATION_SLUG=acme
# BRIDGE_BOOTSTRAP_ORGANIZATION_NAME=Acme
# BRIDGE_BOOTSTRAP_ADMIN_ID=usr_initial_admin
# BRIDGE_BOOTSTRAP_ADMIN_SUBJECT=auth0|subject
# BRIDGE_BOOTSTRAP_ADMIN_NAME=Initial administrator

# Fixed development MCP principal. Standalone MCP OAuth remains a follow-up task.
BRIDGE_MCP_PRINCIPAL_ID=agt_codex
