{
  "name": "@bridge/cli",
  "version": "0.1.0",
  "description": "MCP-optional repository adapter for the Bridge decision and specification control plane",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatilSarvesh/Bridge.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/PatilSarvesh/Bridge#readme",
  "bugs": {
    "url": "https://github.com/PatilSarvesh/Bridge/issues"
  },
  "type": "module",
  "bin": {
    "bridge": "dist/index.js"
  },
  "files": [
    "dist/auth.js",
    "dist/auth.js.map",
    "dist/auth.d.ts",
    "dist/auth.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "pack:local": "pnpm build && pnpm pack --pack-destination ../../dist",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "4.23.11"
  }
}
