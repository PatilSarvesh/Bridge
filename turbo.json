{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "BRIDGE_TEST_DATABASE_URL", "NEXT_PUBLIC_BRIDGE_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
